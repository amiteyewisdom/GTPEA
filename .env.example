# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Org-wide default password assigned to new accounts (bulk import, admin reset, test users).
# Users are forced to change it on first login via /change-password.
DEFAULT_USER_PASSWORD=Gtpea@2025
NEXT_PUBLIC_DEFAULT_USER_PASSWORD=Gtpea@2025

# Nalo Solutions SMS gateway (used for OTP / 2-step verification).
# Leave unset to disable SMS sending — otp send requests will return an error.
NALO_SMS_URL=https://sms.nalosolutions.com/smsbackend/Resl_Nalo/send-message/
NALO_USERNAME=
NALO_PASSWORD=
NALO_SENDER_ID=

# Set to "false" to disable the 2-step (OTP) verification requirement after login.
ENABLE_OTP_LOGIN=true
